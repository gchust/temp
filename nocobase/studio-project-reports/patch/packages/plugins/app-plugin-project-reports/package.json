{
  "name": "@nocobase/app-plugin-project-reports",
  "displayName": "Project Reports App Plugin",
  "version": "0.0.1",
  "description": "Structured daily project progress reports collected by existing runners using their own Git configuration.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": { "node": ">=24.0.0" },
  "sideEffects": false,
  "exports": {
    "./server": { "types": "./server/index.ts", "import": "./server/index.ts" },
    "./client": { "types": "./client/index.ts", "import": "./client/index.ts" },
    "./shared/api": { "types": "./shared/api.ts", "import": "./shared/api.ts" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": { "types": "./dist/server/index.d.ts", "import": "./dist/server/index.js" },
      "./client": { "types": "./dist/client/index.d.ts", "import": "./dist/client/index.js" },
      "./shared/api": { "types": "./dist/shared/api.d.ts", "import": "./dist/shared/api.js" },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runner.mjs && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test tests/collector.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@nocobase/agent-protocol": "workspace:^", "hono": "catalog:", "zod": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-agents": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-authorization": "workspace:^",
    "@nocobase/app-plugin-projects": "workspace:^",
    "@nocobase/app-plugin-scheduler": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "catalog:", "cn": "catalog:",
    "lucide-react": "catalog:", "react": "^19.0.0", "react-dom": "^19.0.0", "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@nocobase/app-testing": "workspace:*", "@nocobase/dev-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:", "@testing-library/react": "catalog:",
    "@types/node": "catalog:", "@types/react": "catalog:",
    "eslint": "catalog:", "jsdom": "catalog:", "prettier": "catalog:",
    "typescript": "catalog:", "vitest": "catalog:"
  }
}
