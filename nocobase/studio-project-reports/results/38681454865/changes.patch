+    expect(points).toHaveLength(7);
+    expect(points[0].date).toBe('2026-10-08');
+    expect(
+      points.every((point) => point.first === null && point.second === null),
+    ).toBe(true);
+    expect(paths(points, 'first', 1)).toEqual([]);
